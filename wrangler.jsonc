{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creamycreation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "creamycreation"
    }
  ],
  // Non-secret runtime vars — plain text is fine, these aren't sensitive.
  // True secrets (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY) stay out of this file;
  // set them via `wrangler secret put` instead (PLAN.md §14, docs/deploy.md).
  "vars": {
    "BAKERY_PRIMARY_EMAIL": "safalranamagar@gmail.com",
    "RESEND_FROM": "onboarding@resend.dev"
  }
}
