{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creamycreation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "creamycreation"
    }
  ]
  // Env vars (BAKERY_*, Supabase, Resend, …) are set in the Cloudflare dashboard
  // per environment — the test→baker switch point (PLAN.md §14). Secrets via
  // `wrangler secret put`, not committed here.
}
