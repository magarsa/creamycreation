# Creamy Creation — environment configuration
#
# Copy to .env.local for local dev and fill in. In production these live in the
# Cloudflare Pages dashboard (per environment), which is the switch point from
# your test values to the baker's real values at launch. See PLAN.md §14.
#
# Values are validated by lib/config.ts at boot — a missing or malformed
# required var fails loudly. Vars marked "(Phase N)" are optional until then.

# --- Bakery identity (swap on cutover) ---
BAKERY_NAME="Creamy Creation"
BAKERY_TAGLINE="Simple, elegant cakes. Made one at a time."
BAKERY_LOCATION="Indian Land, SC"
BAKERY_TIMEZONE="America/New_York"
BAKERY_IG_HANDLE="creamycreation"          # no @ prefix
BAKERY_PRIMARY_EMAIL="you@example.com"
BAKERY_BACKUP_EMAIL="you+backup@example.com"  # cc'd on inquiry emails (optional)

# --- Public site (placeholder until a domain is purchased) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""               # (Phase 1) server-only, never NEXT_PUBLIC

# --- Resend (Phase 1) ---
RESEND_API_KEY=""
RESEND_FROM="orders@example.com"

# --- Google Calendar via published ICS (Phase 3) ---
# Read by the CRON WORKER, not the web app — set it with
#   wrangler secret put BAKERY_ICS_URL --config workers/cron/wrangler.jsonc
# Treat it as a secret: anyone with the URL can read the whole calendar.
# The worker's other bindings (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# RESEND_API_KEY) are the same values as above, set the same way.
# See docs/calendar-setup.md.
BAKERY_ICS_URL=""

# --- Instagram Graph API (Phase 4) ---
IG_LONG_LIVED_TOKEN=""
BAKERY_IG_USER_ID=""                        # numeric user id
